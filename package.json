{
  "name": "@zimspace/z-s-control-plane",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Private Zimspace Storage control-plane and versioned runtime contract foundation.",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime-contract": {
      "types": "./dist/runtime-contract.d.ts",
      "import": "./dist/runtime-contract.js"
    },
    "./runtime-service": {
      "types": "./dist/runtime-service.d.ts",
      "import": "./dist/runtime-service.js"
    },
    "./runtime-storage-registry": {
      "types": "./dist/runtime-storage-registry.d.ts",
      "import": "./dist/runtime-storage-registry.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/runtime-contract.md",
    "db/migrations/0002_z_s_runtime_registry.sql",
    "db/migrations/0002_z_s_runtime_registry.down.sql"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "node scripts/clean-test.mjs && tsc -p tsconfig.test.json",
    "test:focused": "npm run test:compile && node --test .test-dist/tests/control-plane.test.js .test-dist/tests/integrity.test.js .test-dist/tests/runtime-service.test.js .test-dist/tests/runtime-storage-registry.integration.test.js",
    "test:registry": "npm run test:compile && node --test .test-dist/tests/runtime-storage-registry.integration.test.js",
    "test": "npm run test:compile && node --test .test-dist/tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "local:readiness": "node scripts/local-readiness.mjs",
    "validate:migration": "node scripts/validate-migration.mjs",
    "validate:seed": "node scripts/validate-seed.mjs",
    "validate:secrets": "node scripts/scan-secrets.mjs",
    "validate:legacy-id": "node scripts/validate-no-legacy-delivery-id.mjs",
    "pack:check": "npm run build && node scripts/install-smoke.mjs",
    "validate": "npm run test:focused && npm test && npm run typecheck && npm run lint && npm run build && npm run pack:check && npm run validate:migration && npm run validate:seed && npm run validate:secrets && npm run validate:legacy-id && npm run local:readiness",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "typescript": "^5.8.3"
  }
}
