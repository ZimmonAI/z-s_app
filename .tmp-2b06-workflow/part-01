          const serialized = JSON.stringify(lock);
          if (/_authToken|file:|workspace:|link:|git\+|github\.com.*#/i.test(serialized)) {
            throw new Error('prohibited-lock-source');
          }
          NODE

      - name: Install dependencies cleanly
        run: npm ci --ignore-scripts --no-audit --no-fund

      - name: Verify migrations and seeds are unchanged
        if: github.event_name == 'pull_request'
        shell: bash
        run: |
          set -euo pipefail
          git diff --exit-code "${{ github.event.pull_request.base.sha }}...${{ github.event.pull_request.head.sha }}" -- db/migrations db/seeds

      - name: Run focused 2B-06 tests
        run: npm run test:focused

      - name: Run PostgreSQL registry tests
        run: npm run test:registry

