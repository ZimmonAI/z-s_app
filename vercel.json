{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/h08-migrate-0012.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/_internal/h08-migrate-0012",
      "dest": "/api/h08-migrate-0012.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
